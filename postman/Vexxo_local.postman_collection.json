    },
    {
      "name": "06 - Alerts",
      "description": "Pruebas de alertas ya creadas por el backend. Usa el helper para capturar alert_id antes de ejecutar acciones.",
      "item": [
        {
          "name": "List Alerts",
          "request": {
            "description": "Lista alertas visibles del usuario.",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/alerts/alertas/"
          }
        },
        {
          "name": "Get First Alert Id Helper",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (Array.isArray(data) && data.length > 0) {",
                  "    pm.collectionVariables.set('alert_id', data[0].id || '');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "description": "Helper para guardar alert_id con la primera alerta encontrada.",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/alerts/alertas/"
          }
        },
        {
          "name": "Mark Alert Read",
          "request": {
            "description": "Marca como leida la alerta guardada en alert_id.",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/alerts/alertas/{{alert_id}}/mark_read/"
          }
        },
        {
          "name": "Mark Alert Resolved",
          "request": {
            "description": "Marca como resuelta la alerta guardada en alert_id.",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/alerts/alertas/{{alert_id}}/mark_resolved/"
          }
        },
        {
          "name": "Snooze Alert",
          "request": {
            "description": "Pospone una alerta hasta la fecha ISO enviada.",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"until\": \"2026-04-07T09:00:00-05:00\"\n}"
            },
            "url": "{{base_url}}/api/alerts/alertas/{{alert_id}}/snooze/"
          }
        }
      ]
    },
