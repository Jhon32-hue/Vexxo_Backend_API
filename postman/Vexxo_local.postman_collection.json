    {
      "name": "08 - Realtime",
      "description": "Feed tecnico persistido para polling. Ideal para ver señales derivadas de cuentas y pagos.",
      "item": [
        {
          "name": "List Signals",
          "request": {
            "description": "Lista senales realtime del usuario.",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/realtime/consumers/senales-realtime/"
          }
        },
        {
          "name": "Latest Signal",
          "request": {
            "description": "Devuelve la ultima señal disponible o 204 si no hay ninguna.",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/realtime/consumers/senales-realtime/latest/"
          }
        },
        {
          "name": "Signal Stats",
          "request": {
            "description": "Resumen de cantidad total, canales y eventos.",
            "method": "GET",
